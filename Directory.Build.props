<Project>

  <!-- Single source of truth for the product version. NexaTweaks.App.csproj and
       installer/NexaTweaks.iss both read from here (the .iss via /DAppVersion=$(Version)
       passed on the ISCC command line) so a version bump can't drift between the exe,
       the installer filename, and what ships in a release — see the incident where an
       installer built from stale code got published before a security fix. -->
  <PropertyGroup>
    <NexaTweaksVersion>0.1.0</NexaTweaksVersion>
  </PropertyGroup>

</Project>
