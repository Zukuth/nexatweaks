<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base surfaces -->
    <Color x:Key="BgWindowColor">#0A0D14</Color>
    <Color x:Key="BgSidebarColor">#0D111A</Color>
    <Color x:Key="BgCardColor">#151A24</Color>
    <Color x:Key="BgCardHoverColor">#1C2332</Color>
    <Color x:Key="BorderColor">#232A3B</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F1F4FA</Color>
    <Color x:Key="TextSecondaryColor">#8A93A6</Color>
    <Color x:Key="TextMutedColor">#5C6579</Color>

    <!-- Accent -->
    <Color x:Key="AccentVioletColor">#7C5CFF</Color>
    <Color x:Key="AccentCyanColor">#22D3EE</Color>

    <!-- Status -->
    <Color x:Key="SafeColor">#22C55E</Color>
    <Color x:Key="AdvancedColor">#F5A623</Color>
    <Color x:Key="RiskyColor">#EF4444</Color>

    <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource BgWindowColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}"/>

    <SolidColorBrush x:Key="SafeBrush" Color="{StaticResource SafeColor}"/>
    <SolidColorBrush x:Key="AdvancedBrush" Color="{StaticResource AdvancedColor}"/>
    <SolidColorBrush x:Key="RiskyBrush" Color="{StaticResource RiskyColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentVioletColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentCyanColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
