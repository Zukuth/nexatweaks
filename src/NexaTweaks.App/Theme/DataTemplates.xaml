<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels">
    <!--
        DataTemplate content resolves StaticResource against the dictionary that DEFINES the
        template, not wherever it ends up merged - so this file must import everything its
        template body references (brushes, styles, converters) itself, explicitly.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Styles.xaml"/>
        <ResourceDictionary Source="Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="TweakCardTemplate" DataType="{x:Type vm:TweakCardViewModel}">
        <Border Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                    <Style.Triggers>
                        <!-- Lo que este equipo no tiene se ve apagado y no se puede activar. -->
                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderText}" FontSize="13.5"/>
                        <Border CornerRadius="8" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SafeBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Risk}" Value="Advanced">
                                            <Setter Property="Background" Value="{StaticResource AdvancedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Risk}" Value="Risky">
                                            <Setter Property="Background" Value="{StaticResource RiskyBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RiskLabel}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="no reversible" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsReversible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <Border CornerRadius="8" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource BgWindowBrush}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="no disponible" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource RiskyBrush}" FontSize="11" Margin="0,6,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="&#9679; Aplicado" Foreground="{StaticResource SafeBrush}" FontSize="11" FontWeight="SemiBold"
                               Visibility="{Binding IsAppliedAndSynced, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="pendiente" Style="{StaticResource CaptionText}"
                               Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                          IsEnabled="{Binding IsAvailable}"/>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
