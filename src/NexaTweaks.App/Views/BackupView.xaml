<UserControl x:Class="NexaTweaks.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SnapshotCardViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionHeaderText}" FontSize="13.5"/>
                            <TextBlock Text="{Binding Timestamp}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                            <Run Text="{Binding EntryCount, Mode=OneWay}"/>
                            <Run Text=" cambio(s): "/>
                            <Run Text="{Binding EntrySummary, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Restaurar" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,20">
            <TextBlock Text="Backup y restauración" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Cada vez que aplicas cambios se guarda automáticamente una copia del estado anterior. Puedes revertir cualquier snapshot cuando quieras." Style="{StaticResource BodyText}" Margin="0,6,0,16"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Crear punto de restauración de Windows" Style="{StaticResource PrimaryButton}" Command="{Binding CreateRestorePointCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,0,32,28" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Todavía no hay copias de seguridad. Aplica algún tweak desde otra pestaña para crear la primera."
                           Style="{StaticResource BodyText}"
                           Visibility="{Binding Snapshots.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Snapshots}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
