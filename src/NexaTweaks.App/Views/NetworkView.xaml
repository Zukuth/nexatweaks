<UserControl x:Class="NexaTweaks.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DnsResultRowViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Provider}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
                        <TextBlock Text="{Binding Ip}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12.5" Margin="0,0,10,0"/>
                    <Border Grid.Column="2" CornerRadius="6" Padding="6,2" Background="{StaticResource SafeBrush}"
                            Visibility="{Binding IsFastest, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="MÁS RÁPIDO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,20">
            <TextBlock Text="Red" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Latencia, ping y ancho de banda: los tweaks de red clásicos para competitivo, más un benchmark de DNS." Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,0,32,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Benchmark de DNS" Style="{StaticResource SectionHeaderText}" FontSize="13.5"/>
                                <TextBlock Text="Mide la latencia real a los DNS públicos más usados y a tu DNS actual." Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Medir" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                    Command="{Binding RunDnsBenchmarkCommand}" IsEnabled="{Binding IsBenchmarking, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding BenchmarkStatus}" Style="{StaticResource CaptionText}" Margin="0,10,0,10"
                                   Visibility="{Binding BenchmarkStatus, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding DnsResults}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Tweaks de red" Style="{StaticResource SectionHeaderText}" Margin="0,4,0,10"/>
                <ItemsControl ItemsSource="{Binding Tweaks.Cards}" ItemTemplate="{StaticResource TweakCardTemplate}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionText}">
                        <Run Text="{Binding Tweaks.PendingCount, Mode=OneWay}"/>
                        <Run Text=" cambio(s) pendientes"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Tweaks.StatusMessage}" Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Aplicar cambios" Style="{StaticResource PrimaryButton}"
                        Command="{Binding Tweaks.ApplyPendingCommand}" IsEnabled="{Binding Tweaks.IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
