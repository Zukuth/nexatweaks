<UserControl x:Class="NexaTweaks.App.Views.BoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels"
             xmlns:booster="clr-namespace:NexaTweaks.Core.Booster;assembly=NexaTweaks.Core">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type booster:GameProfile}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding ProcessName}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Quitar" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="Booster" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Sube la prioridad del proceso del juego y baja la de apps en segundo plano mientras juegas." Style="{StaticResource BodyText}" Margin="0,6,0,20"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Perfil de juego" Style="{StaticResource SectionHeaderText}" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Margin="0,10,0,0" Padding="8"/>
                    <TextBlock Text="...o escribe el nombre exacto del proceso (sin .exe):" Style="{StaticResource CaptionText}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding CustomProcessName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="{StaticResource BgWindowBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-detectar juego" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
                            <TextBlock Text="Activa el boost solo con abrir un juego de tu lista, y lo detiene al cerrarlo." Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoDetectEnabled}"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Resolución de temporizador alta" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
                            <TextBlock Text="Fija el timer de Windows a ~0.5ms mientras el boost está activo, para un frame pacing más estable." Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TimerResolutionEnabled}"/>
                    </Grid>

                    <Button Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding ToggleBoostCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Activar Boost"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBoosting}" Value="True">
                                        <Setter Property="Content" Value="Detener Boost"/>
                                        <Setter Property="Background" Value="{StaticResource RiskyBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Mis juegos" Style="{StaticResource SectionHeaderText}" Margin="0,24,0,10"/>
            <ItemsControl ItemsSource="{Binding Profiles}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Añadir juego" Style="{StaticResource SectionHeaderText}" FontSize="13"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewGameName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8"
                                 Background="{StaticResource BgWindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                 Tag="Nombre del juego"/>
                        <TextBox Grid.Column="1" Text="{Binding NewGameProcess, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8"
                                 Background="{StaticResource BgWindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                 Tag="Proceso (.exe)"/>
                        <Button Grid.Column="2" Content="Añadir" Style="{StaticResource SecondaryButton}" Command="{Binding AddProfileCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
