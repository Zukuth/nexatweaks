<Window x:Class="NexaTweaks.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Width="420" SizeToContent="Height"
        Title="Confirmar">
    <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="14" Padding="24">
        <StackPanel>
            <Border x:Name="RiskBadge" Width="40" Height="40" CornerRadius="20" Background="{StaticResource RiskyBrush}" HorizontalAlignment="Left">
                <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleBlock" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8" FontSize="17"/>
            <TextBlock x:Name="MessageBlock" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="Sí, aplicar" Style="{StaticResource DangerButton}" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
