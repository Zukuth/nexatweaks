<UserControl x:Class="NexaTweaks.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:NexaTweaks.App.Controls"
             xmlns:diag="clr-namespace:NexaTweaks.Core.Diagnostics;assembly=NexaTweaks.Core">
    <UserControl.Resources>
        <!-- Etiqueta de estado (verde = bien, ámbar = revisar, gris = informativo) -->
        <DataTemplate x:Key="BadgeTemplate" DataType="{x:Type diag:SystemBadge}">
            <Border CornerRadius="7" Padding="9,3" Margin="0,0,8,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgWindowBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="Good">
                                <Setter Property="Background" Value="#1E3A2F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                <Setter Property="Background" Value="#3A2F1E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" FontSize="10.5" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Good">
                                    <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                    <Setter Property="Foreground" Value="{StaticResource AdvancedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BgWindowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentVioletBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="76"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HardwareChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgWindowBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="Panel" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Estado del sistema en tiempo real." Style="{StaticResource BodyText}" Margin="0,6,0,22"/>

            <!-- CPU + GPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource RiskyBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="CPU" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HardwareChip}">
                                <TextBlock Text="{Binding CpuName}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="104" Height="104" Margin="0,0,20,0">
                                <ctrl:RadialGauge Value="{Binding CpuPercent}" TrackBrush="{StaticResource BorderBrush2}"
                                                  ValueBrush="{StaticResource RiskyBrush}" StrokeThickness="9"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F0}%}" Style="{StaticResource StatValueText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="CARGA" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Temperatura" Style="{StaticResource MetricLabel}"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource MetricBar}" Maximum="100"
                                                 Foreground="{StaticResource RiskyBrush}" Value="{Binding CpuTempCelsius, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource MetricValue}"
                                               Text="{Binding CpuTempCelsius, Converter={StaticResource NullableTempConverter}}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Frecuencia" Style="{StaticResource MetricLabel}"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource MetricBar}" Maximum="5000"
                                                 Foreground="{StaticResource RiskyBrush}" Value="{Binding CpuMhz}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource MetricValue}"
                                               Text="{Binding CpuMhz, StringFormat={}{0:F0} MHz}"/>
                                </Grid>
                                <ctrl:Sparkline x:Name="CpuSpark" Height="26" Stroke="{StaticResource RiskyBrush}" MaxValue="100" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource SafeBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="GPU" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HardwareChip}">
                                <TextBlock Text="{Binding GpuName}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="104" Height="104" Margin="0,0,20,0">
                                <ctrl:RadialGauge Value="{Binding GpuPercent}" TrackBrush="{StaticResource BorderBrush2}"
                                                  ValueBrush="{StaticResource SafeBrush}" StrokeThickness="9"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding GpuPercent, StringFormat={}{0:F0}%}" Style="{StaticResource StatValueText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="CARGA" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Uso del motor 3D y de vídeo, medido por Windows." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                <ctrl:Sparkline x:Name="GpuSpark" Height="34" Stroke="{StaticResource SafeBrush}" MaxValue="100" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RAM + RED + ALMACENAMIENTO -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="RAM" Style="{StaticResource CardTitle}"/>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="96" Height="96" Margin="0,0,18,0">
                                <ctrl:RadialGauge Value="{Binding RamPercent}" TrackBrush="{StaticResource BorderBrush2}"
                                                  ValueBrush="{StaticResource AccentCyanBrush}" StrokeThickness="9"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RamPercent, StringFormat={}{0:F0}%}" Style="{StaticResource StatValueText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="USO" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding RamUsedGb, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                    <Run Text=" de "/>
                                    <Run Text="{Binding RamTotalGb, StringFormat={}{0:F1} GB en uso, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="MÓDULOS" Style="{StaticResource CaptionText}" Margin="0,10,0,4" FontWeight="Bold"/>
                                <ItemsControl ItemsSource="{Binding RamModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type diag:RamModuleInfo}">
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,1" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Slot, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding CapacityText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ctrl:Sparkline x:Name="RamSpark" Height="20" Stroke="{StaticResource AccentCyanBrush}" MaxValue="100" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource AccentVioletBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="RED" Style="{StaticResource CardTitle}"/>
                        </StackPanel>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="↓" FontSize="17" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NetDownKbps, StringFormat={}{0:F1} KB/s}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="DESCARGA" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="↑" FontSize="17" Foreground="{StaticResource AccentVioletBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NetUpKbps, StringFormat={}{0:F1} KB/s}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="SUBIDA" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="{StaticResource BorderBrush2}" Height="1" Margin="0,16,0,10"/>
                        <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center">
                            <Run Text="Ping "/>
                            <Run Text="{Binding PingMs, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=" ms · 1.1.1.1"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource AccentVioletBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource CardTitle}"/>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="88" Height="88" Margin="0,0,16,0">
                                <ctrl:RadialGauge Value="{Binding DiskUsedPercent}" TrackBrush="{StaticResource BorderBrush2}"
                                                  ValueBrush="{StaticResource AccentVioletBrush}" StrokeThickness="9"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DiskUsedPercent, StringFormat={}{0:F0}%}" Style="{StaticResource StatValueText}"
                                               HorizontalAlignment="Center" FontSize="17"/>
                                    <TextBlock Text="USADO" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Disco del sistema" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Usado" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding DiskUsedGb, StringFormat={}{0:F1} GB}" Style="{StaticResource MetricValue}" MinWidth="0"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Libre" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding DiskFreeGb, StringFormat={}{0:F1} GB}" Style="{StaticResource MetricValue}"
                                               Foreground="{StaticResource SafeBrush}" MinWidth="0"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Total" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="{Binding DiskTotalGb, StringFormat={}{0:F1} GB}" Style="{StaticResource MetricValue}" MinWidth="0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SISTEMA + PLACA BASE -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SISTEMA" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding OsName}" Style="{StaticResource SectionHeaderText}" FontSize="14" Margin="0,8,0,12"/>
                        <ItemsControl ItemsSource="{Binding WindowsBadges}" ItemTemplate="{StaticResource BadgeTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PLACA BASE" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Motherboard}" Style="{StaticResource SectionHeaderText}" FontSize="14" Margin="0,8,0,12"
                                   TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding BoardBadges}" ItemTemplate="{StaticResource BadgeTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" BorderBrush="{StaticResource AdvancedBrush}"
                    Visibility="{Binding BottleneckMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="{StaticResource AdvancedBrush}" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BottleneckMessage}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Análisis de optimización" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="Descubre qué te falta optimizar y compará el antes/después antes de aplicar nada." Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Analizar mi PC" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                Command="{Binding AnalyzeCommand}" IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <Grid Margin="0,24,0,0" Visibility="{Binding HasAnalyzed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,28,0">
                            <Grid Width="130" Height="130">
                                <ctrl:RadialGauge Value="{Binding OptimizationScore}" TrackBrush="{StaticResource BorderBrush2}" ValueBrush="{StaticResource AccentVioletBrush}" StrokeThickness="12"/>
                                <TextBlock Text="{Binding OptimizationScore, StringFormat={}{0:F0}%}" Style="{StaticResource StatValueText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Ahora" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,28,0">
                            <Grid Width="130" Height="130">
                                <ctrl:RadialGauge Value="100" TrackBrush="{StaticResource BorderBrush2}" ValueBrush="{StaticResource SafeBrush}" StrokeThickness="12"/>
                                <TextBlock Text="100%" Style="{StaticResource StatValueText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Si optimizás" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyText}">
                                <Run Text="{Binding AppliedRecommendedCount, Mode=OneWay}"/>
                                <Run Text=" de "/>
                                <Run Text="{Binding TotalRecommendedCount, Mode=OneWay}"/>
                                <Run Text=" optimizaciones recomendadas ya están aplicadas."/>
                            </TextBlock>
                            <Border Background="{StaticResource BgWindowBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0" MaxHeight="150"
                                    Visibility="{Binding MissingOptimizations.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding MissingOptimizations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2">
                                                    <Run Text="•  "/>
                                                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding CategoryLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Foreground="{StaticResource SafeBrush}"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding DeltaMessage}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Visibility="{Binding DeltaMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Aplicar recomendado" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                Command="{Binding ApplyRecommendedCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Visibility="{Binding HasAnalyzed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
