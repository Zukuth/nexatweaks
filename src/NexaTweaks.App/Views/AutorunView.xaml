<UserControl x:Class="NexaTweaks.App.Views.AutorunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:AutorunRowViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="6" Padding="6,2" Margin="0,0,8,0" Background="{StaticResource BgWindowBrush}">
                                <TextBlock Text="{Binding Source}" Style="{StaticResource CaptionText}" FontSize="10"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <Border CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SafeBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMicrosoftSigned}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource AdvancedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="MICROSOFT"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMicrosoftSigned}" Value="False">
                                                    <Setter Property="Text" Value="SIN FIRMAR"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Command}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RiskyBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Padding="10,4" FontSize="11"
                            Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" IsEnabled="{Binding IsDisabled, Converter={StaticResource InverseBoolConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="Deshabilitar"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                        <Setter Property="Content" Value="✓ Deshabilitado"/>
                                        <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,20">
            <TextBlock Text="Autorun" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Todo lo que arranca solo con Windows: inicio de sesión, tareas programadas y servicios automáticos, en un solo lugar - como Autoruns de Sysinternals." Style="{StaticResource BodyText}" Margin="0,6,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,10,0"
                         Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"
                         Tag="Buscar por nombre o comando..."/>
                <Button Grid.Column="1" Content="Escanear" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                           Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" entradas encontradas · "/>
                    <Run Text="{Binding ThirdPartyCount, Mode=OneWay}"/>
                    <Run Text=" sin firmar por Microsoft"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Mostrar entradas de Microsoft" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowMicrosoftEntries}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,0,32,28" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Tocá &quot;Escanear&quot; para ver qué arranca solo con tu PC." Style="{StaticResource BodyText}"
                           Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding FilteredEntries}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
