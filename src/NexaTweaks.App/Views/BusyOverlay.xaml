<UserControl x:Class="NexaTweaks.App.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border Background="#DD0A0D14"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="52" Height="52" StrokeThickness="4" Stroke="{StaticResource AccentCyanBrush}"
                     StrokeDashArray="4 3" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                    From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"
                       MaxWidth="360" TextAlignment="Center"/>
            <TextBlock Text="Esto puede tardar unos segundos, no cierres la app." Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
