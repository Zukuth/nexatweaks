<UserControl x:Class="NexaTweaks.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:InstalledAppRowViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                            <Run Text="{Binding PublisherText, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding VersionText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Desinstalar" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,20">
            <TextBlock Text="Programas" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Desinstala aplicaciones directamente, sin pasar por el Panel de control de Windows." Style="{StaticResource BodyText}" Margin="0,6,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,10,0"
                         Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"
                         Tag="Buscar programa..."/>
                <Button Grid.Column="1" Content="Actualizar" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,4,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,0,32,28" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredApps}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
