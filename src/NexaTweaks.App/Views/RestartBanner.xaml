<UserControl x:Class="NexaTweaks.App.Views.RestartBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource AdvancedBrush}" Padding="20,10"
            Visibility="{Binding IsRestartNeeded, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Reinicio pendiente" FontWeight="Bold" Foreground="Black" FontSize="13"/>
                <TextBlock Foreground="#1A1A1A" FontSize="11.5" Opacity="0.85">
                    <Run Text="Estos cambios necesitan que reinicies Windows para aplicarse del todo: "/>
                    <Run Text="{Binding ReasonsText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <Button x:Name="RestartButton" Grid.Column="1" Content="Reiniciar ahora" Margin="16,0,10,0" VerticalAlignment="Center"
                    Click="RestartButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="DismissButton" Grid.Column="2" Content="Más tarde" Style="{StaticResource SecondaryButton}"
                    Background="Transparent" BorderThickness="0" Foreground="Black" VerticalAlignment="Center"
                    Click="DismissButton_Click"/>
        </Grid>
    </Border>
</UserControl>
