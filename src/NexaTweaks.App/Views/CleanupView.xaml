<UserControl x:Class="NexaTweaks.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexaTweaks.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:LargeFileRowViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Path}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource CaptionText}" Margin="12,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button Grid.Column="2" Content="Ver en carpeta" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryIssueRowViewModel}">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RiskyBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Padding="10,4" FontSize="11"
                            Command="{Binding DataContext.FixRegistryIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" IsEnabled="{Binding IsFixed, Converter={StaticResource InverseBoolConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="Corregir"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                        <Setter Property="Content" Value="✓ Corregido"/>
                                        <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,20">
            <TextBlock Text="Limpieza" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Temporales, prefetch, RAM en espera, apps de inicio y un analizador de espacio en disco." Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,0,32,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Analizador de espacio en disco" Style="{StaticResource SectionHeaderText}" FontSize="13.5"/>
                        <TextBlock Text="Busca los archivos más grandes dentro de tu carpeta de usuario para que decidas qué borrar." Style="{StaticResource BodyText}" Margin="0,6,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,10,0"
                                     Background="{StaticResource BgWindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}"/>
                            <Button Grid.Column="1" Content="Escanear" Style="{StaticResource PrimaryButton}" Command="{Binding ScanDiskCommand}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                   Visibility="{Binding ScanStatus, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding LargeFiles}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Limpiador de registro" Style="{StaticResource SectionHeaderText}" FontSize="13.5"/>
                                <TextBlock Text="Busca solo entradas huérfanas (que apuntan a archivos que ya no existen). Reversible desde Backup." Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Buscar" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Command="{Binding ScanRegistryCommand}" IsEnabled="{Binding IsScanningRegistry, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Grid.Column="2" Content="Corregir todo" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                    Command="{Binding FixAllRegistryIssuesCommand}" IsEnabled="{Binding IsFixingAllRegistry, Converter={StaticResource InverseBoolConverter}}"
                                    Visibility="{Binding RegistryIssues.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding RegistryScanStatus}" Style="{StaticResource CaptionText}" Margin="0,10,0,10"
                                   Visibility="{Binding RegistryScanStatus, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding RegistryIssues}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Tweaks de limpieza" Style="{StaticResource SectionHeaderText}" Margin="0,4,0,10"/>
                <ItemsControl ItemsSource="{Binding Tweaks.Cards}" ItemTemplate="{StaticResource TweakCardTemplate}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionText}">
                        <Run Text="{Binding Tweaks.PendingCount, Mode=OneWay}"/>
                        <Run Text=" cambio(s) pendientes"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Tweaks.StatusMessage}" Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Aplicar cambios" Style="{StaticResource PrimaryButton}"
                        Command="{Binding Tweaks.ApplyPendingCommand}" IsEnabled="{Binding Tweaks.IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
