<Window x:Class="NexaTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexaTweaks.App"
        xmlns:views="clr-namespace:NexaTweaks.App.Views"
        mc:Ignorable="d"
        Style="{StaticResource AppWindow}"
        Title="Nexa Tweaks Suite" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:RestartBanner Grid.Row="0"/>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/icon.ico" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="NEXA TWEAKS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Windows optimization suite" Style="{StaticResource CaptionText}" Margin="28,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItemButton}" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentVioletBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavWindows" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Windows">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentVioletBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Windows"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Network">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Red"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInput" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Input">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentVioletBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Input"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGpu" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Gpu">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SafeBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="GPU"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Cleanup">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Limpieza"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBooster" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Booster">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SafeBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Booster"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Apps">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Programas"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAutorun" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Autorun">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource RiskyBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Autorun"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRepair" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Repair">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AdvancedBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Reparación"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStability" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Stability">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource RiskyBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Estabilidad"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBackup" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Backup">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentVioletBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Backup"/>
                        </StackPanel>
                    </RadioButton>
                    <Separator Margin="14,10" Background="{StaticResource BorderBrush2}" Height="1"/>
                    <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Advanced">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource RiskyBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Avanzado" Foreground="{StaticResource RiskyBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItemButton}" Checked="Nav_Checked" Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Ajustes"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16" Padding="12" CornerRadius="10" Background="{StaticResource BgCardBrush}">
                    <StackPanel>
                        <TextBlock Text="Todo cambio es reversible" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Revisa la pestaña Backup" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1"/>

        <views:BusyOverlay Grid.Column="0" Grid.ColumnSpan="2"/>
        </Grid>
    </Grid>
</Window>
